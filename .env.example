DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Tradier — market data + brokerage-like paper fills (no live orders)
# Prefer TOKEN_2 (brokerage). TOKEN is accepted as fallback.
TRADIER_API_TOKEN=
TRADIER_API_TOKEN_2=
TRADIER_ACCOUNT_ID=
# Optional: https://api.tradier.com (default) or https://sandbox.tradier.com
TRADIER_API_BASE=https://api.tradier.com
# paper | tradier_paper | tradier | alpaca | ibkr
# If unset and a Tradier token is present, defaults to tradier_paper
AIEM_BROKER_PROVIDER=tradier_paper
TRADIER_PAPER_STARTING_CASH=100000
# Joel fee schedule ($0.65 per contract per leg per side)
TRADIER_PAPER_COMMISSION_OPT=0.65
# Include OCC/ORF/TAF/exchange pass-throughs in paper fees (1=on)
TRADIER_PAPER_REG_FEES=1
# Asym multi-leg paper pricing: tradier_nbbo (default) | polygon_daily
ASYM_PAPER_PRICING=tradier_nbbo
# Optional sandbox base (orders require a sandbox-authorized token)
TRADIER_SANDBOX_BASE=https://sandbox.tradier.com
