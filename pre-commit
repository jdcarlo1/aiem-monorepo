#!/usr/bin/env bash
#
# pre-commit hook: runs verify_signals.py on EVERY commit that touches
# any .py file in the project -- not just the original 3 files. This
# means new modules (added later) are automatically covered, AS LONG AS
# the agent adds matching test cases to verify_signals.py when it adds
# new code. The hook can't write those tests for you -- see the standing
# instruction in replit.md ("User preferences") for that half of it.
#
# Adapted for this repo: verify_signals.py lives under
# artifacts/stock-scanner-api/, not the repo root, so this looks for it
# there and runs it from that directory.
#
# NOTE ON LIMITS:
#   - Only fires on `git commit`. Code run live in the shell without
#     committing is never checked.
#   - `git commit --no-verify` skips this hook. Tell your agent never
#     to use that flag on this repo.
#   - This hook guarantees verify_signals.py RUNS and must PASS. It does
#     NOT guarantee verify_signals.py actually covers new code -- that
#     depends on the agent adding tests for whatever it builds. A hook
#     can enforce "the gate is checked," it can't enforce "the gate is
#     well-built." Periodically ask to see the new test cases it added
#     for any new module, the same way you'd review the module itself.

set -e

GUARD_DIR="artifacts/stock-scanner-api"
VERIFY_SCRIPT="$GUARD_DIR/verify_signals.py"

CHANGED_FILES=$(git diff --cached --name-only)

NEEDS_CHECK=false
for f in $CHANGED_FILES; do
    if [[ "$f" == *.py ]]; then
        NEEDS_CHECK=true
    fi
done

if [ "$NEEDS_CHECK" = false ]; then
    # no Python files changed in this commit, nothing to check
    exit 0
fi

if [ ! -f "$VERIFY_SCRIPT" ]; then
    echo "WARNING: $VERIFY_SCRIPT not found -- skipping check."
    echo "If this is unexpected, something may have moved/deleted it."
    exit 0
fi

echo ""
echo "=================================================================="
echo "pre-commit hook: Python file(s) changed, running verify_signals.py"
echo "=================================================================="

(cd "$GUARD_DIR" && python3 verify_signals.py)
RESULT=$?

if [ $RESULT -ne 0 ]; then
    echo ""
    echo "=================================================================="
    echo "COMMIT BLOCKED: verify_signals.py failed."
    echo "Fix the failing checks before committing."
    echo "=================================================================="
    exit 1
fi

echo ""
echo "verify_signals.py passed -- commit allowed."
exit 0
