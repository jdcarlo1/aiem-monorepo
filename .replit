modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/stock-scanner: probability-engine-scheduler"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/stock-scanner: aiem-process"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/stock-scanner: pattern-discovery"

# git-autosync removed from Project auto-start
# (Directive_FourTLA_And_DaemonRootCause_2026-08-03).
# Start manually via the workflow panel when needed.

[[workflows.workflow]]
name = "artifacts/stock-scanner: probability-engine-scheduler"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/stock-scanner-api/aiem_probability_engine && python3 daily_scheduler.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "artifacts/stock-scanner: aiem-process"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python /home/runner/workspace/artifacts/stock-scanner-api/aiem_process.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "artifacts/stock-scanner: pattern-discovery"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash /home/runner/workspace/artifacts/stock-scanner-api/pattern_discovery_wrapper.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "git-autosync"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 /home/runner/workspace/git_autosync_daemon.py"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0", "github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[[ports]]
localPort = 5050
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 21411
externalPort = 3003

[[ports]]
localPort = 24069
externalPort = 3000

[nix]
channel = "stable-25_05"
packages = ["arrow-cpp", "cairo", "ffmpeg-full", "freetype", "ghostscript", "gobject-introspection", "gtk3", "pkg-config", "qhull", "tcl", "tk"]

