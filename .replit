modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/stock-scanner: uptime-monitor"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/stock-scanner: aiem-process"

[[workflows.workflow]]
name = "artifacts/stock-scanner: uptime-monitor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python /home/runner/workspace/artifacts/stock-scanner-api/monitor.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "artifacts/stock-scanner: aiem-process"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 /home/runner/workspace/aiem_autonomous.py"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 5050
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 21411
externalPort = 3003

[[ports]]
localPort = 24069
externalPort = 3000

[nix]
channel = "stable-25_05"
