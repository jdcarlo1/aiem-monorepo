modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/stock-scanner: uptime-monitor"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/stock-scanner: probability-engine-scheduler"

[[workflows.workflow]]
name = "artifacts/stock-scanner: uptime-monitor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python /home/runner/workspace/artifacts/stock-scanner-api/monitor.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "artifacts/stock-scanner: probability-engine-scheduler"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/stock-scanner-api/aiem_probability_engine && python3 daily_scheduler.py"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 5050
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 21411
externalPort = 3003

[[ports]]
localPort = 24069
externalPort = 3000

[nix]
channel = "stable-25_05"
packages = ["arrow-cpp", "cairo", "ffmpeg-full", "freetype", "ghostscript", "gobject-introspection", "gtk3", "pkg-config", "qhull", "tcl", "tk"]

[userenv]

[userenv.shared]
TELEGRAM_CHAT_ID = "8609255707"
AIEM_HMAC_SECRET = "5c23f047cf614f00cb7c56c53c506f4b3de60fb04f4577259a9743cb1df5e869"
ACCOUNT_VALUE_BASELINE = "20000"
