{"seq": 12, "timestamp_utc": "2026-08-02T16:56:52.476212Z", "command": "psql \"$DATABASE_URL\" -x -c \"\nSELECT ticker, close_strength, rvol, gap_pct, scan_date\nFROM (\n    SELECT ticker, close_strength, rvol, gap_pct, scan_date,\n           ROW_NUMBER() OVER (PARTITION BY ticker ORDER BY scan_date DESC) AS rn\n    FROM polygon_rvol_scan\n    WHERE scan_date >= CURRENT_DATE - INTERVAL '3 days'\n      AND rvol >= 1.5 AND price >= 5.0 AND price <= 500.0\n) latest\nWHERE rn = 1\nORDER BY rvol DESC, ABS(gap_pct) DESC LIMIT 25;\n\"", "exit_code": 0, "output_sha256": "d7a93040666773ba958099952be50f26ab4a7284e3a110714476e9bb8dc46f2d", "prev_hash": "afb4e6d9f5eaab124c1376b2693ef67af27d0c8dbb200ce19dcd8375a660cc1a", "entry_hash": "bad2a2642cd0875bfd9290ad00e7e2b3fec9146d793613ad38d5e2cd9a1e5219"}
