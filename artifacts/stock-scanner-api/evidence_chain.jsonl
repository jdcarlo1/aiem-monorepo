{"seq": 14, "timestamp_utc": "2026-08-02T16:57:12.243259Z", "command": "python3 -c \"\nimport sys, os; sys.path.insert(0, '/home/runner/workspace/artifacts/stock-scanner-api')\nfrom datetime import datetime\n\ndef _gate(atm_iv_value, ticker='SIM_TICKER', run_id='test_trace_item2'):\n    if atm_iv_value is None:\n        msg=(f'[{run_id}] module=chain_data ticker={ticker} status=MISSING '\n             f'field=atm_iv source_ts={datetime.utcnow().isoformat()}Z '\n             f'\u2014 INSUFFICIENT_DATA; aborting job')\n        print('GATE FIRED:', msg)\n        return False\n    return True\n\nok_a=_gate(None);   print('Case A atm_iv=None  proceed={} verdict={}'.format(ok_a,'INSUFFICIENT_DATA' if not ok_a else 'PROCEED'))\nok_b=_gate(0.28);   print('Case B atm_iv=0.28  proceed={} verdict={}'.format(ok_b,'INSUFFICIENT_DATA' if not ok_b else 'PROCEED'))\nassert not ok_a,'FAIL: gate did not block on None'\nassert ok_b,    'FAIL: gate blocked on valid float'\nprint('NEGATIVE_CONTROL: PASS')\n\"", "exit_code": 0, "output_sha256": "862a8c70f626d8968f5e1d371e8457f104abd3940abef653e6c26ce48339e2ac", "prev_hash": "fb71324772bb6ae5b130fb4a4c36c3db0d4b3ee60d4646210fb313747586aaa1", "entry_hash": "65d88e3d6978440abe395ff5f2b7ed3a7ed396144c73f452e92cbb9dca086747"}
