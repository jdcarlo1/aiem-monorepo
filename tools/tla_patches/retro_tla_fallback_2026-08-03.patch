+def _compute_diff_sha(sha: str, protected_files: list[str]) -> str:
+    """Compute sha256 of the pinned-format diff for the commit's protected files.
+
+    Flags keep output byte-identical regardless of git config:
+      --no-pager    prevents pager injection
+      --no-color    no ANSI codes
+      --no-ext-diff no diff.external hook
+      --format=%H   commit header only (no message body)
+    Files are sorted so insertion order cannot change the hash.
+    """
+    rc, out, _ = _run(
+        ["git", "--no-pager", "show", "--no-color", "--no-ext-diff", "--format=%H",
+         sha, "--"] + sorted(protected_files)
+    )
+    if rc != 0:
+        return ""
+    return hashlib.sha256(out.encode()).hexdigest()
+
