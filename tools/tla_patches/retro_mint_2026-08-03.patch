+def get_commit_protected_files(sha: str) -> list[str]:
+    """Return the protected files changed by an existing commit."""
+    result = subprocess.run(
+        ["git", "diff-tree", "--no-commit-id", "-r", "--name-only", sha],
+        capture_output=True, text=True, check=False
+    )
+    if result.returncode != 0:
+        return []
+    return sorted(p.strip() for p in result.stdout.splitlines()
+                  if p.strip() and is_protected(p.strip()))
+
+
+def get_retro_diff_sha(sha: str, protected_files: list[str]) -> str:
+    """Compute sha256 of the pinned-format diff for an existing commit.
+
+    Flags keep output byte-identical regardless of git config:
+      --no-pager    prevents pager injection
+      --no-color    no ANSI codes
+      --no-ext-diff no diff.external hook
+      --format=%H   commit header only (no message body)
+    Files are sorted so insertion order cannot change the hash.
+    """
+    result = subprocess.run(
+        ["git", "--no-pager", "show", "--no-color", "--no-ext-diff", "--format=%H",
+         sha, "--"] + sorted(protected_files),
+        capture_output=True, check=False
+    )
+    return hashlib.sha256(result.stdout).hexdigest()
+
