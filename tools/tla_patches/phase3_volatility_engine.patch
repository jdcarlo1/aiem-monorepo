+"""
+aiem_options_volatility_engine.py — Phase 3: Volatility Intelligence
+Source: AIEM_OPTIONS_AUTONOMY_MASTER_DIRECTIVE.txt §5
+Created: 2026-08-02
+
+Computes and persists the full volatility profile for a given ticker:
+  ATM IV, 52-week IV rank, IV percentile, realized vol (HV20), VRP,
+  term structure (front/back IV ratio + tag), put/call skew,
+  expected move, event IV expansion, estimated IV crush, and
+  volatility regime (LOW | NORMAL | HIGH | EXTREME).
+
+Persistence: oe_volatility_snapshots (INSERT-only; no UPDATE/DELETE).
+
+Data sources:
+  - Polygon options chain (live)  → ATM IV, term structure, skew
+  - polygon_market_daily (DB)     → HV(20d) from close prices
+  - oe_volatility_snapshots (DB)  → rolling window for IV rank/percentile
+  - oe_options_metrics (DB)       → seed IV history where snapshots sparse
+
+STANDING RULES (per directive §14):
+  - No DELETE / TRUNCATE / UPDATE on any row.
+  - Non-fatal: every public function logs and returns a sentinel on error.
+  - IV rank and IV percentile are ALWAYS independently computed — never
+    substituted by a simple "ATM IV > threshold" comparison.
+
+Hardcoded constants — trace:
+  _IV_HISTORY_WINDOW_DAYS = 252  → standard 52-week rolling window
+  _IV_HISTORY_MIN_ROWS    = 3    → below this return status=INSUFFICIENT_HISTORY
+  _HV_WINDOW_DAYS         = 20   → HV(20d), industry-standard short-term RV
+  _HV_ANNUALIZE           = 252  → annualisation factor (trading days/year)
+  _ATM_STRIKE_TOL_PCT     = 0.05 → ±5% of spot accepted as ATM
+  _SKEW_OTM_PCT           = 0.05 → 5% OTM for skew measurement legs
+  _IV_RANK_EPSILON        = 1e-6 → prevents div/0 when high==low
+  _IV_CRUSH_FACTOR        = 0.40 → empirical: ~40% of VRP evaporates post-event
+  _TERM_STALE_DAYS        = 3    → options chain older than 3 calendar days is stale
+  Regime thresholds (iv_rank): LOW<20, NORMAL 20-50, HIGH 50-80, EXTREME≥80
+    — Natenberg "Option Volatility and Pricing" §12 conventional breakpoints.
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+import os
+from dataclasses import dataclass
+from datetime import date, datetime, timedelta, timezone
+from typing import List, Optional, Tuple
+
+import psycopg2
+import psycopg2.extras
+
+log = logging.getLogger("aiem.options.volatility_engine")
+
+_DB_URL = os.environ.get("DATABASE_URL", "")
+
+# ── Hardcoded constants (all documented above) ────────────────────────────────
+_IV_HISTORY_WINDOW_DAYS = 252
+_IV_HISTORY_MIN_ROWS    = 3
+_HV_WINDOW_DAYS         = 20
+_HV_ANNUALIZE           = 252
+_ATM_STRIKE_TOL_PCT     = 0.05
+_SKEW_OTM_PCT           = 0.05
+_IV_RANK_EPSILON        = 1e-6
+_IV_CRUSH_FACTOR        = 0.40
+_TERM_STALE_DAYS        = 3
+
+# IV rank regime thresholds
+_REGIME_LOW_MAX      = 20.0   # iv_rank < 20  → LOW
+_REGIME_NORMAL_MAX   = 50.0   # iv_rank < 50  → NORMAL
+_REGIME_HIGH_MAX     = 80.0   # iv_rank < 80  → HIGH
+# iv_rank >= 80 → EXTREME
+
+# ── Schema bootstrap ──────────────────────────────────────────────────────────
+_DDL_VOLATILITY_SNAPSHOTS = """
+CREATE TABLE IF NOT EXISTS oe_volatility_snapshots (
+    id                  BIGSERIAL PRIMARY KEY,
+    ticker              VARCHAR(20)  NOT NULL,
+    snap_date           DATE         NOT NULL,
+    atm_iv              NUMERIC(10,6),
+    iv_rank             NUMERIC(8,2),
+    iv_percentile       NUMERIC(8,2),
+    realized_vol_20d    NUMERIC(10,6),
+    vrp                 NUMERIC(10,6),
+    front_iv            NUMERIC(10,6),
+    back_iv             NUMERIC(10,6),
+    term_ratio          NUMERIC(8,4),
+    term_tag            VARCHAR(30),
+    put_skew_iv         NUMERIC(10,6),
+    call_skew_iv        NUMERIC(10,6),
+    pc_skew_pp          NUMERIC(8,2),
+    skew_tag            VARCHAR(30),
+    spot                NUMERIC(12,4),
+    expected_move       NUMERIC(12,4),
+    expected_move_pct   NUMERIC(8,4),
+    dte_used            INTEGER,
+    event_iv_expansion  NUMERIC(8,4),
+    iv_crush_estimate   NUMERIC(10,6),
+    near_event          BOOLEAN,
+    volatility_regime   VARCHAR(10),
+    iv_low_window       NUMERIC(10,6),
+    iv_high_window      NUMERIC(10,6),
+    iv_window_rows      INTEGER,
+    data_source         VARCHAR(50),
+    captured_at         TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
+    UNIQUE (ticker, snap_date)
+);
+CREATE INDEX IF NOT EXISTS idx_oe_vol_snap_ticker_date
+    ON oe_volatility_snapshots (ticker, snap_date DESC);
+"""
+
+_bootstrapped = False
+
+
+def _bootstrap() -> None:
+    global _bootstrapped
+    if _bootstrapped:
+        return
+    try:
+        with psycopg2.connect(_DB_URL) as conn:
+            with conn.cursor() as cur:
+                cur.execute(_DDL_VOLATILITY_SNAPSHOTS)
+            conn.commit()
+        _bootstrapped = True
+        log.info("[vol_engine] oe_volatility_snapshots bootstrapped")
+    except Exception as exc:
+        log.error("[vol_engine] bootstrap failed: %s", exc)
+
+
+# ── Output dataclass ──────────────────────────────────────────────────────────
+@dataclass(frozen=True)
+class VolatilitySnapshot:
+    ticker:              str
+    snap_date:           date
+    atm_iv:              Optional[float]
+    iv_rank:             Optional[float]   # 0–100
+    iv_percentile:       Optional[float]   # 0–100
+    realized_vol_20d:    Optional[float]   # annualised HV(20d)
+    vrp:                 Optional[float]   # atm_iv – realized_vol_20d
+    front_iv:            Optional[float]
+    back_iv:             Optional[float]
+    term_ratio:          Optional[float]   # back_iv / front_iv
+    term_tag:            Optional[str]     # CONTANGO | BACKWARDATION | FLAT
+    put_skew_iv:         Optional[float]
+    call_skew_iv:        Optional[float]
+    pc_skew_pp:          Optional[float]   # put_skew_iv – call_skew_iv in pp
+    skew_tag:            Optional[str]     # FEAR_PREMIUM | CALL_SKEW | BALANCED
+    spot:                Optional[float]
+    expected_move:       Optional[float]
+    expected_move_pct:   Optional[float]
+    dte_used:            Optional[int]
+    event_iv_expansion:  Optional[float]   # how much IV elevated vs trailing mean
+    iv_crush_estimate:   Optional[float]   # estimated post-event IV drop
+    near_event:          bool
+    volatility_regime:   Optional[str]     # LOW | NORMAL | HIGH | EXTREME
+    iv_low_window:       Optional[float]
+    iv_high_window:      Optional[float]
+    iv_window_rows:      int
+    data_source:         str
+    status:              str               # OK | PARTIAL | NO_DATA | INSUFFICIENT_HISTORY
+    blocking_reason:     Optional[str]
+
+
+# ── DB helpers ────────────────────────────────────────────────────────────────
+def _conn():
+    return psycopg2.connect(_DB_URL)
+
+
+# ── Component: HV(20d) from polygon_market_daily ──────────────────────────────
+def _compute_hv20(ticker: str) -> Optional[float]:
+    """
+    Annualised historical volatility over the last 20 trading days.
+    Formula: std(log(c_t / c_{t-1}), ddof=1) * sqrt(252)
+    Requires at least 21 close prices to produce 20 log-returns.
+    """
+    try:
+        with _conn() as conn:
+            with conn.cursor() as cur:
+                cur.execute(
+                    """
+                    SELECT close_price
+                    FROM   polygon_market_daily
+                    WHERE  ticker = %s
+                      AND  close_price IS NOT NULL
+                      AND  close_price > 0
+                    ORDER  BY scan_date DESC
+                    LIMIT  %s
+                    """,
+                    (ticker, _HV_WINDOW_DAYS + 5),
+                )
+                rows = cur.fetchall()
+    except Exception as exc:
+        log.warning("[vol_engine] hv20 DB error for %s: %s", ticker, exc)
+        return None
+
+    closes = [float(r[0]) for r in rows]
+    if len(closes) < _HV_WINDOW_DAYS + 1:
+        log.debug("[vol_engine] hv20: insufficient bars for %s (%d)", ticker, len(closes))
+        return None
+
+    # closes are DESC — reverse to get chronological order
+    closes = closes[::-1]
+    log_returns = [
+        math.log(closes[i] / closes[i - 1])
+        for i in range(1, len(closes))
+        if closes[i - 1] > 0
+    ]
+    if len(log_returns) < _HV_WINDOW_DAYS:
+        return None
+    log_returns = log_returns[-_HV_WINDOW_DAYS:]
+
+    n  = len(log_returns)
+    mu = sum(log_returns) / n
+    variance = sum((r - mu) ** 2 for r in log_returns) / (n - 1)   # ddof=1
+    hv = math.sqrt(variance) * math.sqrt(_HV_ANNUALIZE)
+    return round(hv, 6)
+
+
+# ── Component: ATM IV + term structure + skew from live Polygon chain ─────────
+def _fetch_chain_volatility(
+    ticker: str, spot: float, dte_target: int = 5
+) -> dict:
+    """
+    Returns:
+      atm_iv, front_iv, back_iv, term_ratio, term_tag,
+      put_skew_iv, call_skew_iv, pc_skew_pp, skew_tag,
+      expected_move, expected_move_pct, dte_used,
+      status ('OK'|'FAILED')
+    """
+    result: dict = {"status": "FAILED"}
+    try:
+        import aiem_polygon_options_chain as _chain_mod  # noqa: PLC0415
+        chain = _chain_mod.fetch_options_chain(
+            ticker, min_dte=max(1, dte_target - 2), max_dte=60
+        )
+    except Exception as exc:
+        log.warning("[vol_engine] chain fetch failed for %s: %s", ticker, exc)
+        return result
+
+    calls = chain.get("calls", [])
+    puts  = chain.get("puts",  [])
+    if not calls and not puts:
+        return result
+
+    # ── Group expirations ─────────────────────────────────────────────────────
+    exp_to_calls: dict[str, list] = {}
+    exp_to_puts:  dict[str, list] = {}
+    for c in calls:
+        exp = c.get("expiration_date")
+        if exp:
+            exp_to_calls.setdefault(exp, []).append(c)
+    for p in puts:
+        exp = p.get("expiration_date")
+        if exp:
+            exp_to_puts.setdefault(exp, []).append(p)
+
+    all_exps = sorted(set(exp_to_calls) | set(exp_to_puts))
+    if not all_exps:
+        return result
+
+    front_exp = all_exps[0]
+    back_exp  = all_exps[1] if len(all_exps) > 1 else None
+
+    def _atm_iv_for_exp(exp: str, spot: float) -> Optional[float]:
+        """Average IV of ATM call and ATM put for the given expiry."""
+        tol = spot * _ATM_STRIKE_TOL_PCT
+        atm_calls = [
+            c for c in exp_to_calls.get(exp, [])
+            if c.get("implied_volatility") and abs(float(c["strike"]) - spot) <= tol
+        ]
+        atm_puts = [
+            p for p in exp_to_puts.get(exp, [])
+            if p.get("implied_volatility") and abs(float(p["strike"]) - spot) <= tol
+        ]
+        ivs: list[float] = []
+        for c in atm_calls:
+            ivs.append(float(c["implied_volatility"]))
+        for p in atm_puts:
+            ivs.append(float(p["implied_volatility"]))
+        if not ivs:
+            # Widen to nearest strike regardless of tolerance
+            all_c = [c for c in exp_to_calls.get(exp, []) if c.get("implied_volatility")]
+            all_p = [p for p in exp_to_puts.get(exp, []) if p.get("implied_volatility")]
+            nearest_c = min(all_c, key=lambda c: abs(float(c["strike"]) - spot), default=None)
+            nearest_p = min(all_p, key=lambda p: abs(float(p["strike"]) - spot), default=None)
+            if nearest_c:
+                ivs.append(float(nearest_c["implied_volatility"]))
+            if nearest_p:
+                ivs.append(float(nearest_p["implied_volatility"]))
+        return round(sum(ivs) / len(ivs), 6) if ivs else None
+
+    front_iv = _atm_iv_for_exp(front_exp, spot)
+    back_iv  = _atm_iv_for_exp(back_exp, spot) if back_exp else None
+
+    # dte for front expiry
+    try:
+        dte_used = (date.fromisoformat(front_exp) - date.today()).days
+    except Exception:
+        dte_used = dte_target
+
+    # ── Skew: 5% OTM put vs 5% OTM call ─────────────────────────────────────
+    put_target  = spot * (1 - _SKEW_OTM_PCT)
+    call_target = spot * (1 + _SKEW_OTM_PCT)
+
+    def _closest_iv(contracts: list, target_strike: float) -> Optional[float]:
+        valid = [c for c in contracts if c.get("implied_volatility") and float(c.get("implied_volatility", 0)) > 0]
+        if not valid:
+            return None
+        best = min(valid, key=lambda c: abs(float(c["strike"]) - target_strike))
+        return round(float(best["implied_volatility"]), 6)
+
+    put_skew_iv  = _closest_iv(exp_to_puts.get(front_exp, []),  put_target)
+    call_skew_iv = _closest_iv(exp_to_calls.get(front_exp, []), call_target)
+
+    pc_skew_pp: Optional[float] = None
+    skew_tag: Optional[str] = None
+    if put_skew_iv is not None and call_skew_iv is not None:
+        pc_skew_pp = round((put_skew_iv - call_skew_iv) * 100, 2)
+        if pc_skew_pp >= 8:
+            skew_tag = "FEAR_PREMIUM"
+        elif pc_skew_pp <= -4:
+            skew_tag = "CALL_SKEW"
+        else:
+            skew_tag = "BALANCED"
+
+    # ── Term structure ────────────────────────────────────────────────────────
+    term_ratio: Optional[float] = None
+    term_tag:   Optional[str]   = None
+    if front_iv and back_iv and front_iv > 0:
+        term_ratio = round(back_iv / front_iv, 4)
+        if term_ratio > 1.05:
+            term_tag = "CONTANGO"       # back > front — normal carry
+        elif term_ratio < 0.95:
+            term_tag = "BACKWARDATION"  # back < front — event / fear in front
+        else:
+            term_tag = "FLAT"
+
+    # ── Expected move ─────────────────────────────────────────────────────────
+    atm_iv = front_iv
+    expected_move: Optional[float] = None
+    expected_move_pct: Optional[float] = None
+    if atm_iv and spot and dte_used and dte_used > 0:
+        em = round(spot * atm_iv * math.sqrt(dte_used / _HV_ANNUALIZE), 4)
+        expected_move = em
+        expected_move_pct = round(em / spot * 100, 4) if spot > 0 else None
+
+    result.update(
+        status="OK",
+        atm_iv=atm_iv,
+        front_iv=front_iv,
+        back_iv=back_iv,
+        term_ratio=term_ratio,
+        term_tag=term_tag,
+        put_skew_iv=put_skew_iv,
+        call_skew_iv=call_skew_iv,
+        pc_skew_pp=pc_skew_pp,
+        skew_tag=skew_tag,
+        expected_move=expected_move,
+        expected_move_pct=expected_move_pct,
+        dte_used=dte_used,
+    )
+    return result
+
+
+# ── Component: IV rank + IV percentile from rolling history ───────────────────
+def _compute_iv_rank_percentile(
+    ticker: str, current_iv: float
+) -> dict:
+    """
+    Queries oe_volatility_snapshots for the last 252 days of atm_iv.
+    If fewer than _IV_HISTORY_MIN_ROWS found, seeds from oe_options_metrics.iv.
+
+    IV rank      = (current_iv − min_window) / max(max_window − min_window, ε) × 100
+    IV percentile = count(history < current_iv) / count(history) × 100
+
+    Both formulas are computed independently — never substituted by each other.
+
+    Returns: {iv_rank, iv_percentile, iv_low, iv_high, window_rows, status}
+    """
+    cutoff = date.today() - timedelta(days=_IV_HISTORY_WINDOW_DAYS)
+    iv_history: List[float] = []
+
+    try:
+        with _conn() as conn:
+            with conn.cursor() as cur:
+                # Primary: oe_volatility_snapshots
+                cur.execute(
+                    """
+                    SELECT atm_iv
+                    FROM   oe_volatility_snapshots
+                    WHERE  ticker   = %s
+                      AND  snap_date >= %s
+                      AND  atm_iv   IS NOT NULL
+                      AND  atm_iv   > 0
+                    ORDER  BY snap_date ASC
+                    """,
+                    (ticker, cutoff),
+                )
+                iv_history = [float(r[0]) for r in cur.fetchall()]
+
+                # Seed from oe_options_metrics if history is sparse
+                if len(iv_history) < _IV_HISTORY_MIN_ROWS:
+                    cur.execute(
+                        """
+                        SELECT iv
+                        FROM   oe_options_metrics
+                        WHERE  ticker   = %s
+                          AND  scan_date >= %s
+                          AND  iv        IS NOT NULL
+                          AND  iv        > 0
+                        ORDER  BY scan_date ASC
+                        """,
+                        (ticker, cutoff),
+                    )
+                    seed = [float(r[0]) for r in cur.fetchall()]
+                    iv_history = sorted(set(iv_history + seed))
+                    log.debug(
+                        "[vol_engine] iv_rank seeded from oe_options_metrics: %d rows for %s",
+                        len(seed), ticker,
+                    )
+    except Exception as exc:
+        log.warning("[vol_engine] iv_rank DB error for %s: %s", ticker, exc)
+        return {"status": "DB_ERROR"}
+
+    if len(iv_history) < _IV_HISTORY_MIN_ROWS:
+        return {
+            "status":      "INSUFFICIENT_HISTORY",
+            "window_rows": len(iv_history),
+            "iv_low":      None,
+            "iv_high":     None,
+        }
+
+    iv_low  = min(iv_history)
+    iv_high = max(iv_history)
+    n       = len(iv_history)
+
+    # IV rank formula (per directive §5):
+    #   iv_rank = (current_iv − rolling_low) / max(rolling_high − rolling_low, ε) × 100
+    iv_rank = (
+        (current_iv - iv_low)
+        / max(iv_high - iv_low, _IV_RANK_EPSILON)
+        * 100.0
+    )
+    iv_rank = max(0.0, min(100.0, round(iv_rank, 2)))
+
+    # IV percentile (per directive §5):
+    #   percent of historical observations strictly below current IV
+    below = sum(1 for v in iv_history if v < current_iv)
+    iv_percentile = round(below / n * 100.0, 2)
+
+    return {
+        "status":        "OK",
+        "iv_rank":       iv_rank,
+        "iv_percentile": iv_percentile,
+        "iv_low":        round(iv_low,  6),
+        "iv_high":       round(iv_high, 6),
+        "window_rows":   n,
+    }
+
+
+# ── Component: volatility regime classification ───────────────────────────────
+def _classify_regime(iv_rank: float) -> str:
+    """
+    LOW      iv_rank < 20   — IV cheap; favour long vol / debit spreads
+    NORMAL   20 ≤ rank < 50 — neutral; strategy-agnostic
+    HIGH     50 ≤ rank < 80 — IV elevated; favour credit spreads / short vol
+    EXTREME  rank ≥ 80      — IV very expensive; favour defined-risk credit / condors
+    """
+    if iv_rank < _REGIME_LOW_MAX:
+        return "LOW"
+    elif iv_rank < _REGIME_NORMAL_MAX:
+        return "NORMAL"
+    elif iv_rank < _REGIME_HIGH_MAX:
+        return "HIGH"
+    else:
+        return "EXTREME"
+
+
+# ── Component: event proximity + IV expansion + IV crush estimate ─────────────
+def _compute_event_signals(
+    ticker: str, current_iv: float, realized_vol: Optional[float]
+) -> dict:
+    """
+    Detects whether ATM IV is elevated above its recent mean (suggests event risk).
+    Uses last-14-day average atm_iv from oe_volatility_snapshots as baseline.
+
+    event_iv_expansion = current_iv / trailing_mean_iv − 1   (fraction above mean)
+    iv_crush_estimate  = (current_iv − realized_vol) × _IV_CRUSH_FACTOR
+                         only when near_event=True; None otherwise.
+
+    near_event is True when event_iv_expansion > 0.15 (IV at least 15% above baseline).
+    """
+    trailing_mean: Optional[float] = None
+    try:
+        cutoff14 = date.today() - timedelta(days=14)
+        with _conn() as conn:
+            with conn.cursor() as cur:
+                cur.execute(
+                    """
+                    SELECT AVG(atm_iv)
+                    FROM   oe_volatility_snapshots
+                    WHERE  ticker   = %s
+                      AND  snap_date >= %s
+                      AND  atm_iv   IS NOT NULL
+                      AND  atm_iv   > 0
+                    """,
+                    (ticker, cutoff14),
+                )
+                row = cur.fetchone()
+                if row and row[0]:
+                    trailing_mean = float(row[0])
+    except Exception as exc:
+        log.debug("[vol_engine] event signals DB error for %s: %s", ticker, exc)
+
+    event_iv_expansion: Optional[float] = None
+    near_event = False
+    if trailing_mean and trailing_mean > 0:
+        event_iv_expansion = round(current_iv / trailing_mean - 1.0, 4)
+        near_event = event_iv_expansion > 0.15
+
+    iv_crush_estimate: Optional[float] = None
+    if near_event and realized_vol is not None and current_iv > realized_vol:
+        iv_crush_estimate = round((current_iv - realized_vol) * _IV_CRUSH_FACTOR, 6)
+
+    return {
+        "event_iv_expansion": event_iv_expansion,
+        "near_event":         near_event,
+        "iv_crush_estimate":  iv_crush_estimate,
+    }
+
+
+# ── Component: spot price from DB ────────────────────────────────────────────
+def _get_spot(ticker: str) -> Optional[float]:
+    try:
+        with _conn() as conn:
+            with conn.cursor() as cur:
+                cur.execute(
+                    """
+                    SELECT close_price
+                    FROM   polygon_market_daily
+                    WHERE  ticker = %s
+                      AND  close_price > 0
+                    ORDER  BY scan_date DESC
+                    LIMIT  1
+                    """,
+                    (ticker,),
+                )
+                row = cur.fetchone()
+                return float(row[0]) if row else None
+    except Exception as exc:
+        log.warning("[vol_engine] spot lookup failed for %s: %s", ticker, exc)
+        return None
+
+
+# ── Persistence ───────────────────────────────────────────────────────────────
+def persist_volatility_snapshot(snap: VolatilitySnapshot) -> bool:
+    """
+    INSERT into oe_volatility_snapshots.
+    ON CONFLICT (ticker, snap_date) DO NOTHING — first write per day is permanent.
+    Returns True if a new row was inserted, False on conflict or error.
+    """
+    _bootstrap()
+    try:
+        with _conn() as conn:
+            with conn.cursor() as cur:
+                cur.execute(
+                    """
+                    INSERT INTO oe_volatility_snapshots (
+                        ticker, snap_date, atm_iv, iv_rank, iv_percentile,
+                        realized_vol_20d, vrp, front_iv, back_iv,
+                        term_ratio, term_tag, put_skew_iv, call_skew_iv,
+                        pc_skew_pp, skew_tag, spot, expected_move,
+                        expected_move_pct, dte_used, event_iv_expansion,
+                        iv_crush_estimate, near_event, volatility_regime,
+                        iv_low_window, iv_high_window, iv_window_rows,
+                        data_source
+                    ) VALUES (
+                        %(ticker)s, %(snap_date)s, %(atm_iv)s, %(iv_rank)s,
+                        %(iv_percentile)s, %(realized_vol_20d)s, %(vrp)s,
+                        %(front_iv)s, %(back_iv)s, %(term_ratio)s, %(term_tag)s,
+                        %(put_skew_iv)s, %(call_skew_iv)s, %(pc_skew_pp)s,
+                        %(skew_tag)s, %(spot)s, %(expected_move)s,
+                        %(expected_move_pct)s, %(dte_used)s,
+                        %(event_iv_expansion)s, %(iv_crush_estimate)s,
+                        %(near_event)s, %(volatility_regime)s,
+                        %(iv_low_window)s, %(iv_high_window)s,
+                        %(iv_window_rows)s, %(data_source)s
+                    )
+                    ON CONFLICT (ticker, snap_date) DO NOTHING
+                    """,
+                    {
+                        "ticker":              snap.ticker,
+                        "snap_date":           snap.snap_date,
+                        "atm_iv":              snap.atm_iv,
+                        "iv_rank":             snap.iv_rank,
+                        "iv_percentile":       snap.iv_percentile,
+                        "realized_vol_20d":    snap.realized_vol_20d,
+                        "vrp":                 snap.vrp,
+                        "front_iv":            snap.front_iv,
+                        "back_iv":             snap.back_iv,
+                        "term_ratio":          snap.term_ratio,
+                        "term_tag":            snap.term_tag,
+                        "put_skew_iv":         snap.put_skew_iv,
+                        "call_skew_iv":        snap.call_skew_iv,
+                        "pc_skew_pp":          snap.pc_skew_pp,
+                        "skew_tag":            snap.skew_tag,
+                        "spot":                snap.spot,
+                        "expected_move":       snap.expected_move,
+                        "expected_move_pct":   snap.expected_move_pct,
+                        "dte_used":            snap.dte_used,
+                        "event_iv_expansion":  snap.event_iv_expansion,
+                        "iv_crush_estimate":   snap.iv_crush_estimate,
+                        "near_event":          snap.near_event,
+                        "volatility_regime":   snap.volatility_regime,
+                        "iv_low_window":       snap.iv_low_window,
+                        "iv_high_window":      snap.iv_high_window,
+                        "iv_window_rows":      snap.iv_window_rows,
+                        "data_source":         snap.data_source,
+                    },
+                )
+                inserted = cur.rowcount == 1
+            conn.commit()
+        return inserted
+    except Exception as exc:
+        log.error("[vol_engine] persist failed for %s/%s: %s",
+                  snap.ticker, snap.snap_date, exc)
+        return False
+
+
+# ── Main entry point ──────────────────────────────────────────────────────────
+def run_volatility_engine(
+    ticker: str,
+    dte: int = 5,
+    spot_override: Optional[float] = None,
+) -> VolatilitySnapshot:
+    """
+    Compute the full volatility profile for `ticker`.
+
+    Returns a VolatilitySnapshot. Never raises — on any error, returns a
+    snapshot with status='NO_DATA' and the relevant blocking_reason set.
+
+    Parameters
+    ----------
+    ticker         : exchange ticker symbol
+    dte            : target DTE for expected-move calculation (default 5)
+    spot_override  : skip DB spot lookup and use this price (testing only)
+    """
+    _bootstrap()
+    today = date.today()
+    _source = "polygon_live+polygon_market_daily"
+
+    def _empty(reason: str) -> VolatilitySnapshot:
+        return VolatilitySnapshot(
+            ticker=ticker, snap_date=today,
+            atm_iv=None, iv_rank=None, iv_percentile=None,
+            realized_vol_20d=None, vrp=None,
+            front_iv=None, back_iv=None,
+            term_ratio=None, term_tag=None,
+            put_skew_iv=None, call_skew_iv=None,
+            pc_skew_pp=None, skew_tag=None,
+            spot=None,
+            expected_move=None, expected_move_pct=None, dte_used=None,
+            event_iv_expansion=None, iv_crush_estimate=None,
+            near_event=False,
+            volatility_regime=None,
+            iv_low_window=None, iv_high_window=None, iv_window_rows=0,
+            data_source=_source,
+            status="NO_DATA",
+            blocking_reason=reason,
+        )
+
+    # ── 1. Spot price ─────────────────────────────────────────────────────────
+    spot = spot_override if spot_override is not None else _get_spot(ticker)
+    if spot is None:
+        return _empty(f"spot_missing:no_price_data_for_{ticker}")
+
+    # ── 2. Live chain: ATM IV, term structure, skew, expected move ────────────
+    chain_result = _fetch_chain_volatility(ticker, spot, dte)
+    atm_iv = chain_result.get("atm_iv")
+    if chain_result.get("status") != "OK" or atm_iv is None:
+        return _empty(f"chain_failed:no_atm_iv_from_polygon_for_{ticker}")
+
+    # ── 3. Realized vol HV(20d) ───────────────────────────────────────────────
+    realized_vol = _compute_hv20(ticker)
+
+    # ── 4. VRP = ATM_IV − HV(20d) ────────────────────────────────────────────
+    vrp: Optional[float] = None
+    if realized_vol is not None:
+        vrp = round(atm_iv - realized_vol, 6)
+
+    # ── 5. IV rank + IV percentile from rolling history ───────────────────────
+    iv_result    = _compute_iv_rank_percentile(ticker, atm_iv)
+    iv_rank      = iv_result.get("iv_rank")
+    iv_percentile = iv_result.get("iv_percentile")
+    iv_low       = iv_result.get("iv_low")
+    iv_high      = iv_result.get("iv_high")
+    iv_window_rows = iv_result.get("window_rows", 0)
+    iv_status    = iv_result.get("status", "UNKNOWN")
+
+    # ── 6. Volatility regime ──────────────────────────────────────────────────
+    volatility_regime: Optional[str] = None
+    if iv_rank is not None:
+        volatility_regime = _classify_regime(iv_rank)
+
+    # ── 7. Event signals ──────────────────────────────────────────────────────
+    ev_signals = _compute_event_signals(ticker, atm_iv, realized_vol)
+
+    # ── 8. Determine overall status ───────────────────────────────────────────
+    if iv_status == "INSUFFICIENT_HISTORY":
+        overall_status = "PARTIAL"
+        blocking = (
+            f"iv_rank_percentile:insufficient_history"
+            f"({iv_window_rows}<{_IV_HISTORY_MIN_ROWS})"
+        )
+    elif iv_status == "DB_ERROR":
+        overall_status = "PARTIAL"
+        blocking = "iv_rank_percentile:db_error"
+    elif realized_vol is None:
+        overall_status = "PARTIAL"
+        blocking = "hv20:insufficient_price_history"
+    else:
+        overall_status = "OK"
+        blocking = None
+
+    return VolatilitySnapshot(
+        ticker=ticker,
+        snap_date=today,
+        atm_iv=atm_iv,
+        iv_rank=iv_rank,
+        iv_percentile=iv_percentile,
+        realized_vol_20d=realized_vol,
+        vrp=vrp,
+        front_iv=chain_result.get("front_iv"),
+        back_iv=chain_result.get("back_iv"),
+        term_ratio=chain_result.get("term_ratio"),
+        term_tag=chain_result.get("term_tag"),
+        put_skew_iv=chain_result.get("put_skew_iv"),
+        call_skew_iv=chain_result.get("call_skew_iv"),
+        pc_skew_pp=chain_result.get("pc_skew_pp"),
+        skew_tag=chain_result.get("skew_tag"),
+        spot=spot,
+        expected_move=chain_result.get("expected_move"),
+        expected_move_pct=chain_result.get("expected_move_pct"),
+        dte_used=chain_result.get("dte_used"),
+        event_iv_expansion=ev_signals.get("event_iv_expansion"),
+        iv_crush_estimate=ev_signals.get("iv_crush_estimate"),
+        near_event=ev_signals.get("near_event", False),
+        volatility_regime=volatility_regime,
+        iv_low_window=iv_low,
+        iv_high_window=iv_high,
+        iv_window_rows=iv_window_rows,
+        data_source=_source,
+        status=overall_status,
+        blocking_reason=blocking,
+    )
