#!/usr/bin/env bash
# prepare-commit-msg hook — auto-inject [TLA-<id>] into commit message.
#
# When TLA_APPROVAL_ID is set in the environment (i.e. the committer ran
#   TLA_APPROVAL_ID=<id> git commit -m "..."
# ), this hook appends the correctly-formatted token:
#   [TLA-<id>]
# to the commit message so the pre-push gate (check_protected_push.py) can
# find it with its _TLA_RE regex: \[TLA-([0-9a-f]{8})\]
#
# This prevents the format bug where [TLA-xxxxxxxx] was written as
# "TLA: xxxxxxxx" (colon, no brackets).  With this hook the committer
# never has to remember the bracket format — it is injected automatically.
#
# INSTALLATION (one-time per clone):
#   bash tools/hooks/install.sh
# Or manually:
#   cp tools/hooks/prepare-commit-msg .git/hooks/prepare-commit-msg
#   chmod +x .git/hooks/prepare-commit-msg

COMMIT_MSG_FILE="$1"
# $2 = commit source (message/template/merge/squash/commit); unused here.

if [ -z "${TLA_APPROVAL_ID:-}" ]; then
    exit 0   # no TLA in flight — nothing to do
fi

# Only inject if the token is not already present (idempotent).
if ! grep -qF "[TLA-${TLA_APPROVAL_ID}]" "$COMMIT_MSG_FILE"; then
    printf '\n[TLA-%s]\n' "${TLA_APPROVAL_ID}" >> "$COMMIT_MSG_FILE"
fi
